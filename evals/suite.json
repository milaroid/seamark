  "cases": {
    "develop--edge": {
      "category": "documentation",
      "checks": [
        {
          "id": "reference-preserved",
          "kind": "unchanged",
          "paths": [
            "reference/*"
          ]
        }
      ],
      "ablation": false,
      "required_files": [
        "reference/develop.md"
      ],
      "initial_diff": []
    },
    "develop--execute": {
      "category": "execution",
      "checks": [
        {
          "id": "function-changed",
          "kind": "changed",
          "paths": [
            "email.go"
          ]
        },
        {
          "id": "new-tests-exist",
          "kind": "exists",
          "paths": [
            "normalize_test.go"
          ]
        },
        {
          "id": "existing-tests-preserved",
          "kind": "unchanged",
          "paths": [
            "email_test.go",
            "go.mod"
          ]
        },
        {
          "id": "scope",
          "kind": "changes",
          "paths": [
            "email.go",
            "normalize_test.go",
            ".m/*"
          ]
        },
        {
          "id": "tests-executed",
          "kind": "command",
          "argv": [
            "go",
            "test"
          ],
          "success": true
        },
        {
          "id": "independent-tests",
          "kind": "oracle",
          "file": "normalize_test.go"
        },
        {
          "id": "ordered-phases",
          "kind": "phases",
          "names": [
            "refine",
            "plan",
            "implement",
            "review",
            "iterate"
          ]
        },
        {
          "id": "phase-markers",
          "kind": "exists",
          "paths": [
            ".m/phase-refine-done",
            ".m/phase-plan-done",
            ".m/phase-implement-done",
            ".m/phase-review-done",
            ".m/phase-iterate-done"
          ]
        },
        {
          "id": "pipeline-cleanup",
          "kind": "absent",
          "paths": [
            ".m/DEVELOP_ACTIVE"
          ]
        },
        {
          "id": "progress-updated",
          "kind": "changed",
          "paths": [
            ".m/PROGRESS.md"
          ]
        },
        {
          "id": "expected-verdict",
          "kind": "verdict",
          "values": [
            "PASSED"
          ]
        },
        {
          "id": "persisted-prd",
          "kind": "glob_contains",
          "glob": ".m/PRD-*.md",
          "text": "## 8. Success Criteria"
        }
      ],
      "ablation": false,
      "required_files": [
        "go.mod",
        ".m/INDEX.md",
        ".m/pipeline.yml",
        "email.go",
        "email_test.go",
        ".m/PLAN.md"
      ],
      "initial_diff": []
    },
